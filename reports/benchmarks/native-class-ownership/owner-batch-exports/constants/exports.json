  "decisionFile": "reports/benchmarks/native-class-ownership/owner-batch-study/decision.cjs",
  "capturePolicy": "reports/benchmarks/native-class-ownership/owner-batch-study/constants/capture.json",
  "samplerPolicy": "reports/benchmarks/native-class-ownership/owner-batch-study/constants/sampler.json",
  "resourcePolicy": "reports/benchmarks/native-class-ownership/owner-batch-study/constants/resources.json",
  "transportPolicy": "reports/benchmarks/native-class-ownership/owner-batch-study/constants/transport.json",
  "executablePolicy": "reports/benchmarks/native-class-ownership/constants/current-ownership.json",
  "decisionFilename": "decision.json",
  "verifiedDirectory": "verified",
  "commandDirectory": "decision-command",
  "invocationFilename": "invocation.json",
  "orchestratorStdoutFilename": "orchestrator.stdout.log",
  "orchestratorStderrFilename": "orchestrator.stderr.log",
  "summaryFilename": "export-summary.json",
  "manifestFilename": "export-manifest.json",
  "tablesDirectory": "tables",
  "comparisonFilename": "comparisons.json",
  "maximumCommandSeconds": 300,
  "compressionLevel": 9,
  "maximumJSONBytes": 16777216,
  "dimensions": ["nodeVersion", "sourceCommit", "phase", "engine", "label", "physicalDistribution", "position", "rowIndex", "rowKey", "pid"],
  "nativeStages": {"baseline": "baseline", "cleanup": "cleanup"},
  "tables": {
    "tasks": {"filename": "tasks.csv.gz", "columns": ["blockIndex", "stage", "taskIndex", "processMonotonicStartMs", "durationMs", "outputHash"]},
    "blocks": {"filename": "blocks.csv.gz", "columns": ["blockIndex", "stage", "tasks", "withinRealmWarmupRounds", "meanMs", "nativeCreatedBeforeWarmup", "nativeCreatedBefore", "nativeCreatedAfter"]},
    "processes": {"filename": "processes.csv.gz", "columns": ["sequence", "measuredDurations", "warmupDurations", "processMeanMs", "measuredBlocks", "warmupBlocks", "windows", "documents", "nativeApplicable", "firstCleanupClear", "finalClearStates"]},
    "cleanup": {"filename": "cleanup.csv.gz", "columns": ["round", "clear", "survivingWindows", "survivingDocuments", "rssBytes", "heapTotalBytes", "heapUsedBytes", "externalBytes", "arrayBuffersBytes", "nativeApplicable"]},
    "nativeCounters": {"filename": "native-counters.csv.gz", "columns": ["stage", "round", "field", "valueType", "value", "baselineValue", "delta"]},
    "parents": {"filename": "parents.csv.gz", "standaloneDimensions": ["nodeVersion", "sourceCommit", "parentPid"], "columns": ["stage", "completedWorkers", "observedAtUTC", "processMonotonicMs", "rssBytes", "heapTotalBytes", "heapUsedBytes", "externalBytes", "arrayBuffersBytes", "cpuUserMicroseconds", "cpuSystemMicroseconds"]}
  },
  "scope": {
    "inferenceUnit": "paired fresh process mean of 144 measured task durations",
    "taskDurationsAreIndependentReplicates": false,
    "clockScope": "performance.now() is local to its recorded process; clocks are not joined across processes or hosts",
    "nativeMissingness": "jsdom has no native Rust baseline or endpoints; no native counter rows are fabricated",
    "nativeDeltas": "numeric endpoint minus its recorded native baseline; cumulative counter deltas alone are not leaks",
    "booleanDeltas": "not applicable, represented as an empty CSV cell",
    "innerWarmup": "declared rounds are retained; no duration is invented for untimed inner warmup",
    "peakMemoryMeasured": false,
    "universalLeakAbsenceClaimed": false,
    "functionalCoverage": "Only the authenticated controller parts are tabulated; standalone worker qualification reports remain in the original ZIPs and are not counted as controller samples"
  }
}
