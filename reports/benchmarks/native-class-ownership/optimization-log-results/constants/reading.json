{
  "prefixes": [
    ["[marking dependent code", "dependent-code"],
    ["[bailout (", "bailout-start"],
    ["[bailout end.", "bailout-end"],
    ["[marking ", "optimization-mark"],
    ["[compiling method", "compile-start"],
    ["[completed compiling", "compile-complete"],
    ["[completed optimizing", "optimization-complete"],
    ["[optimizing ", "optimization-complete"],
    ["[aborted compiling", "compile-aborted"],
    ["[aborted optimizing", "optimization-aborted"],
    ["[evicting optimized code", "code-eviction"],
    ["[disabled optimization", "optimization-disabled"],
    ["[OSR", "osr"]
  ],
  "patterns": {
    "bailoutReason": "^\\[bailout \\(kind: (.*?), reason: (.*?)\\): begin\\.",
    "dependentReason": "reason: (.*)\\]$",
    "function": "<JSFunction (.*?) \\(sfi = (0x[0-9a-f]+)\\)>",
    "sharedFunction": "<SharedFunctionInfo ([^>]*)>",
    "tier": "<Code ([^>]+)>",
    "targetTier": "\\(target ([^)]+)\\)",
    "abortReason": "because: (.*?) - took ",
    "optimizationId": "opt id ([0-9]+)"
  }
}
