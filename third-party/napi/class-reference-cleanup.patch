+/// Native constructor-reference lifecycle diagnostics for the patched runtime.
+#[doc(hidden)]
+#[cfg(all(feature = "napi3", not(feature = "noop"), not(target_family = "wasm")))]
+pub fn class_reference_statistics() -> [usize; 4] {
+  [CLASS_REFS_LIVE.load(Ordering::Relaxed), CLASS_REFS_CREATED.load(Ordering::Relaxed),
+   CLASS_REFS_RELEASED.load(Ordering::Relaxed), CLASS_REFS_CLEANUP_ERRORS.load(Ordering::Relaxed)]
+}
