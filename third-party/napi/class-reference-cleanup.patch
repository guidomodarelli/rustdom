+#[cfg(all(feature = "napi3", not(feature = "noop"), not(target_family = "wasm")))]
+unsafe extern "C" fn cleanup_class_references(data: *mut std::ffi::c_void) {
+  // SAFETY: this unique Box is installed once and called on its owning env's thread.
+  let cleanup = unsafe { Box::from_raw(data.cast::<ClassReferenceCleanup>()) };
+  let owned: HashSet<_, FxBuildHasher> = cleanup.references.iter().copied().collect();
+  REGISTERED_CLASSES.with(|cell| cell.borrow_mut(|classes| {
+    // A later registration may have replaced this thread's constructor map.
+    // Remove only references owned by this cleanup, never another env's refs.
+    classes.retain(|_, reference| !owned.contains(reference));
+  }));
+  for reference in cleanup.references {
+    // SAFETY: Node runs cleanup before destroying the env and its user-owned refs.
+    if unsafe { sys::napi_delete_reference(cleanup.env, reference) } == sys::Status::napi_ok {
+      CLASS_REFS_LIVE.fetch_sub(1, Ordering::Relaxed);
+      CLASS_REFS_RELEASED.fetch_add(1, Ordering::Relaxed);
+    } else {
+      CLASS_REFS_CLEANUP_ERRORS.fetch_add(1, Ordering::Relaxed);
+    }
+  }
 }
 
