{
  "name": "@rustdom/rustdom",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Compatibility-first DOM with native Rust parsing, storage, queries and serialization",
  "license": "MIT",
  "repository": "github:guidomodarelli/rustdom",
  "main": "dist/index.cjs",
  "types": "types/index.d.cts",
  "files": [
    "dist",
    "src/environments",
    "types",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jest": {
      "types": "./types/jest.d.cts",
      "default": "./src/environments/jest.cjs"
    },
    "./vitest": {
      "types": "./types/vitest.d.mts",
      "default": "./src/environments/vitest.mjs"
    },
    "./native": {
      "import": {
        "types": "./types/native.d.mts",
        "default": "./dist/native.mjs"
      },
      "require": {
        "types": "./types/native.d.cts",
        "default": "./dist/native.cjs"
      }
    }
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:js": "node scripts/build.mjs",
    "build": "npm run build:native && npm run build:js",
    "test:jest": "jest --runInBand",
    "test:compat": "node --test tests/*.spec.cjs",
    "test:corpus": "node --expose-gc tests/corpus/run.cjs",
    "test:wpt": "node tests/wpt/run.cjs",
    "test:memory": "node scripts/memory-check.cjs",
    "test:native-memory": "node scripts/native-memory.mjs",
    "validate": "node scripts/validate.mjs",
    "test:validation": "node --test tests/validation/*.spec.mjs",
    "test:vitest": "vitest run",
    "test:vm": "vitest run --config vitest.vm.config.mjs",
    "test": "npm run test:compat && npm run test:jest && npm run test:vitest && npm run test:vm",
    "bench": "node --expose-gc benchmarks/compare.cjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:package": "node scripts/package-check.mjs"
  },
  "napi": {
    "binaryName": "rustdom",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin"
    ]
  },
  "dependencies": {
    "@jest/environment": "30.5.0",
    "@remix-run/multipart-parser": "0.16.4",
    "@types/jsdom": "27.0.0",
    "jsdom": "27.4.0",
    "parse5": "8.0.0",
    "symbol-tree": "3.2.4",
    "webidl-conversions": "8.0.1"
  },
  "peerDependencies": {
    "@jest/environment-jsdom-abstract": "^30.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@jest/environment-jsdom-abstract": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/environment-jsdom-abstract": "30.5.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@xml-conformance-suite/test-data": "3.0.0",
    "jest": "30.5.1",
    "pnpm": "12.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
