{
  "name": "@rustdom/rustdom",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Experimental html5ever parsing for a compatibility-first jsdom runtime",
  "main": "dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs",
    "./jest": "./src/environments/jest.cjs",
    "./vitest": "./src/environments/vitest.mjs",
    "./native": "./dist/native.cjs"
  },
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:js": "node scripts/build.mjs",
    "build": "npm run build:native && npm run build:js",
    "test:jest": "jest --runInBand",
    "test:compat": "node --test tests/*.spec.cjs",
    "test:corpus": "node --expose-gc tests/corpus/run.cjs",
    "test:memory": "node scripts/memory-check.cjs",
    "validate": "node scripts/validate.mjs",
    "test:vitest": "vitest run",
    "test": "npm run test:compat && npm run test:jest && npm run test:vitest",
    "bench": "node --expose-gc benchmarks/compare.cjs"
  },
  "napi": { "binaryName": "rustdom", "targets": ["x86_64-unknown-linux-gnu", "x86_64-pc-windows-msvc", "aarch64-apple-darwin"] },
  "dependencies": { "jsdom": "27.4.0", "parse5": "8.0.0" },
  "peerDependencies": { "@jest/environment-jsdom-abstract": "^30.0.0", "vitest": "^5.0.0" },
  "peerDependenciesMeta": { "@jest/environment-jsdom-abstract": { "optional": true }, "vitest": { "optional": true } },
  "devDependencies": {
    "@jest/environment-jsdom-abstract": "30.5.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jest": "30.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vitest": "5.0.0"
  }
}
